# frozen_string_literal: true

require "base64"
require "cgi"
require "fileutils"
require "json"
require "shellwords"
require "tmpdir"

opt_out_usage

# Internal TestFlight for the one multiplatform target.
#
# What this is, and is not:
#   Technical uploads for App Store Connect Users / an optional internal group.
#   Not a public beta, not App Store review, not a GitHub Release.
#
# How the neighbours do this (looked at 2026-08-21):
#   Swiftfin  — GitHub Actions + Fastlane, p12 + profiles in secrets
#   strimr    — GitHub Actions + Fastlane Match, iOS + tvOS + macOS
#   silo      — same family as strimr, reserved build numbers, internal/external switch
#   Rivulet   — unsigned compile on Actions; archives on Codemagic
#   Sodalite  — universal TestFlight link, no release CI in the repo
#
# We stay on GitHub Actions (`xcode-27` for archives — the project is Xcode 27's
# `project.xcproj`) and skip Match / Codemagic / Xcode Cloud unless someone asks.
# Signing is a persistent Apple Distribution p12 (Swiftfin) plus sigh
# profiles created from the App Store Connect API key — entitlements can
# change without re-exporting a profile secret.
#
# Do not open this project with the Fastlane `xcodeproj` gem or gym.
# `Xcodeproj::Project.open` and gym both look for `project.pbxproj`, which
# this repo does not have. Sign by patching `project.xcproj`; archive with
# `xcodebuild archive` / `exportArchive`.
#
# Secrets, first-time Apple setup, and when CI uploads: docs/testflight.md.

default_platform(:ios)

PROJECT = File.expand_path("../KinoPubAppleClient.xcodeproj", __dir__)
XCPROJ = File.join(PROJECT, "project.xcproj")
SCHEME = "KinoPubAppleClient"
APP_TARGET = "KinoPubAppleClient"
BUNDLE_ID = "com.soda.kinopub"
TEAM_ID = "Z2PQ733PSP"
APP_NAME = "Kinopub Soda"

# xcodebuild destination / TestFlight platform / sigh platform / artifact name
PLATFORMS = {
  "ios" => {
    destination: "generic/platform=iOS",
    sdk: "iphoneos",
    testflight: "ios",
    sigh: "ios",
    output: "KinoPub-iOS",
    mac: false
  },
  "tvos" => {
    destination: "generic/platform=tvOS",
    sdk: "appletvos",
    testflight: "appletvos",
    sigh: "tvos",
    output: "KinoPub-tvOS",
    mac: false
  },
  "macos" => {
    destination: "generic/platform=macOS",
    sdk: "macosx",
    testflight: "osx",
    sigh: "macos",
    output: "KinoPub-macOS",
    mac: true
  }
}.freeze

TESTFLIGHT_QUERY_PLATFORMS = %w[ios appletvos osx].freeze

def require_env!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing #{name}. See the comment at the top of .github/workflows/testflight.yml.") if value.empty?
  value
end

def connect_api_key
  return @connect_api_key if @connect_api_key

  raw = require_env!("APP_STORE_CONNECT_API_KEY_CONTENT")
  pem = raw.include?("BEGIN PRIVATE KEY")
  @connect_api_key = app_store_connect_api_key(
    key_id: require_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: require_env!("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: pem ? raw : raw.gsub(/\s+/, ""),
    is_key_content_base64: !pem,
    duration: 1200,
    in_house: false
  )
end

def decode_base64_env(name)
  raw = require_env!(name).gsub(/\s+/, "")
  decoded = Base64.decode64(raw)
  UI.user_error!("#{name} did not decode as base64") if decoded.nil? || decoded.empty?
  decoded
end

def write_temp_binary(basename, bytes)
  path = File.join(Dir.tmpdir, basename)
  File.binwrite(path, bytes)
  path
end

def platform_spec
  name = ENV.fetch("TESTFLIGHT_PLATFORM", "ios").strip.downcase
  spec = PLATFORMS[name]
  UI.user_error!("Unknown TESTFLIGHT_PLATFORM #{name.inspect}. Use ios, tvos, or macos.") if spec.nil?
  spec.merge(name: name)
end

def resolved_build_number
  injected = ENV["BUILD_NUMBER"].to_s.strip
  unless injected.empty?
    UI.user_error!("BUILD_NUMBER must be a positive integer, got #{injected.inspect}") unless injected.match?(/\A[1-9]\d*\z/)
    return injected
  end

  next_build_number(api_key: connect_api_key).to_s
end

def next_build_number(api_key:)
  latest_for(api_key: api_key).max + 1
end

def latest_for(api_key:)
  TESTFLIGHT_QUERY_PLATFORMS.map do |platform|
    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      platform: platform,
      initial_build_number: 0
    )
  rescue StandardError => e
    UI.important("No TestFlight builds for #{platform} (#{e.message})")
    0
  end
end

def require_appstore_connect_app!(api_key:)
  connect_api_key unless api_key.nil?
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  return app unless app.nil?

  UI.user_error!(
    "No App Store Connect app for #{BUNDLE_ID}. Create it once: " \
    "App Store Connect → Apps → (+) → iOS, name #{APP_NAME}, then add Apple TV and Mac " \
    "on the app record so the same bundle id is a universal purchase."
  )
end

def changelog_text
  from_env = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
  return from_env unless from_env.empty?

  from_whats_new = whats_new_notes
  return from_whats_new unless from_whats_new.empty?

  from_md = changelog_md_notes
  return from_md unless from_md.empty?

  log = `git log -15 --pretty=format:"- %s"`.strip
  log.empty? ? "Internal technical build." : log
end

def marketing_version
  File.read(XCPROJ)[/"MARKETING_VERSION": "([^"]+)"/, 1] || "1.0"
end

# In-app What's New for this marketing version (Russian — Sasha's TestFlight).
def whats_new_notes
  path = File.expand_path("../KinoPubAppleClient/Resources/whats-new.json", __dir__)
  return "" unless File.exist?(path)

  payload = JSON.parse(File.read(path))
  entries = Array(payload["entries"])
  version = marketing_version
  entry = entries.find { |item| item["version"].to_s == version } || entries.first
  return "" if entry.nil?

  bullets = Array(entry["ru"])
  bullets = Array(entry["en"]) if bullets.empty?
  bullets.map { |line| line.to_s.strip }.reject(&:empty?).map { |line| "• #{line}" }.join("\n")
rescue JSON::ParserError => e
  UI.important("whats-new.json did not parse (#{e.message})")
  ""
end

def changelog_md_notes
  path = File.expand_path("../CHANGELOG.md", __dir__)
  return "" unless File.exist?(path)

  text = File.read(path)
  version = marketing_version
  chunk = text[/\n## #{Regexp.escape(version)}\n(.*?)(?=\n## |\z)/m, 1]
  chunk ||= text[/\n## Unreleased\n(.*?)(?=\n## [^U]|\z)/m, 1]
  return "" if chunk.nil?

  bullets = chunk.scan(/^- \*\*(.+?)\*\*[^\n]*/).flatten
  bullets = chunk.scan(/^- (.+)/).flatten if bullets.empty?
  bullets.map { |line| line.to_s.gsub(/\s+/, " ").strip }.reject(&:empty?).first(8).map { |line| "• #{line}" }.join("\n")
end

def internal_groups
  ENV["TESTFLIGHT_INTERNAL_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
end

def keychain_name
  ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain-db"
end

def keychain_password
  ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
end

def import_p12!(env_bytes:, env_password:, filename:)
  path = write_temp_binary(filename, decode_base64_env(env_bytes))
  import_certificate(
    certificate_path: path,
    certificate_password: require_env!(env_password),
    keychain_name: keychain_name,
    keychain_password: keychain_password,
    log_output: true
  )
ensure
  File.delete(path) if path && File.exist?(path)
end

def install_signing!(macos:)
  unless ENV["CI"]
    UI.message("Local run: using Apple Distribution certificates already in the keychain")
    return
  end

  setup_ci

  import_p12!(
    env_bytes: "BUILD_CERTIFICATE_BASE64",
    env_password: "P12_PASSWORD",
    filename: "apple-distribution.p12"
  )

  return unless macos

  import_p12!(
    env_bytes: "MAC_INSTALLER_CERTIFICATE_BASE64",
    env_password: "MAC_INSTALLER_CERTIFICATE_PASSWORD",
    filename: "mac-installer.p12"
  )
end

def fetch_profile!(sigh_platform:)
  # sigh's filename option only accepts .mobileprovision, including macOS.
  get_provisioning_profile(
    app_identifier: BUNDLE_ID,
    api_key: connect_api_key,
    adhoc: false,
    force: ENV["CI"].to_s == "true",
    provisioning_name: "KinoPub #{sigh_platform} AppStore",
    filename: "KinoPub-#{sigh_platform}.mobileprovision",
    output_path: Dir.tmpdir,
    platform: sigh_platform,
    team_id: TEAM_ID
  )
  lane_context[SharedValues::SIGH_NAME]
end

def require_xcproj!
  UI.user_error!("Missing #{XCPROJ}. This repo is an Xcode 27 project.xcproj, not pbxproj.") unless File.exist?(XCPROJ)
  pbx = File.join(PROJECT, "project.pbxproj")
  return unless File.exist?(pbx)

  UI.user_error!("Found #{pbx}; expected only project.xcproj. Do not add a pbxproj sidecar.")
end

def app_target_slice(text)
  start = text.index(/"name": "#{APP_TARGET}"/)
  UI.user_error!("Missing target #{APP_TARGET} in project.xcproj") if start.nil?

  finish = text.index(/"name": "KinoPubAppleClientTests"/, start)
  UI.user_error!("Could not bound #{APP_TARGET} build-settings in project.xcproj") if finish.nil?

  [text[0...start], text[start...finish], text[finish..]]
end

def replace_once!(body, pattern, replacement, label:)
  matches = body.scan(pattern)
  UI.user_error!("Expected #{label} once in the app target, found #{matches.size}") unless matches.size == 1
  body.sub(pattern, replacement)
end

# Sign the app target only. xcargs CODE_SIGN_IDENTITY / PROVISIONING_PROFILE_SPECIFIER
# apply to every target in the graph — SPM packages then fail with "does not support
# provisioning profiles", and `CODE_SIGN_IDENTITY[sdk=macosx*]` was parsed as the
# identity `macosx*]=Apple Distribution`.
#
# The Fastlane xcodeproj gem cannot open Xcode 27's project.xcproj (it looks for
# project.pbxproj). Patch the JSON5 keys in the app target's build-settings only.
def apply_app_signing_to!(path, profile_name:)
  text = File.read(path)
  head, body, tail = app_target_slice(text)

  body = replace_once!(
    body,
    /"CODE_SIGN_IDENTITY": "Apple Development"/,
    '"CODE_SIGN_IDENTITY": "Apple Distribution"',
    label: "CODE_SIGN_IDENTITY"
  )
  body = replace_once!(
    body,
    /"CODE_SIGN_IDENTITY\[sdk=macosx\*\]": "Apple Development"/,
    '"CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Distribution"',
    label: "CODE_SIGN_IDENTITY[sdk=macosx*]"
  )
  body = replace_once!(
    body,
    /"CODE_SIGN_STYLE": "Automatic"/,
    '"CODE_SIGN_STYLE": "Manual"',
    label: "CODE_SIGN_STYLE"
  )
  body = replace_once!(
    body,
    /"PROVISIONING_PROFILE_SPECIFIER": ""/,
    "\"PROVISIONING_PROFILE_SPECIFIER\": #{JSON.generate(profile_name)}",
    label: "PROVISIONING_PROFILE_SPECIFIER"
  )

  File.write(path, head + body + tail)
end

def apply_app_signing!(profile_name:)
  require_xcproj!
  apply_app_signing_to!(XCPROJ, profile_name: profile_name)
end

def xml_escape(value)
  CGI.escapeHTML(value.to_s)
end

def write_export_options!(profile_name:, mac:)
  path = File.join(Dir.tmpdir, mac ? "KinoPub-macOS-ExportOptions.plist" : "KinoPub-ExportOptions.plist")
  # macOS Release 38228644573 compiled, then exportArchive used the installer
  # cert as the app identity against the App Store profile. Pin Apple
  # Distribution for the app and 3rd Party Mac Developer Installer for the pkg.
  mac_certs = if mac
    <<~KEYS
        <key>signingCertificate</key>
        <string>Apple Distribution</string>
        <key>installerSigningCertificate</key>
        <string>3rd Party Mac Developer Installer</string>
    KEYS
  else
    ""
  end
  File.write(
    path,
    <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>teamID</key>
        <string>#{xml_escape(TEAM_ID)}</string>
        <key>destination</key>
        <string>export</string>
        <key>manageAppVersionAndBuildNumber</key>
        <false/>
        <key>stripSwiftSymbols</key>
        <true/>
        #{mac_certs}<key>provisioningProfiles</key>
        <dict>
          <key>#{xml_escape(BUNDLE_ID)}</key>
          <string>#{xml_escape(profile_name)}</string>
        </dict>
      </dict>
      </plist>
    PLIST
  )
  path
end

# Writes the build's "What to Test" text into Info.plist as `KPReleaseNotes`. Nothing in
# the app reads it since 2026-10-16 (What's New reads whats-new.json) — ROADMAP has the
# TODO to drop it. The checkout is throwaway, so the plist is edited in place rather than
# through xcargs, which do not survive a multi-line value.
def write_release_notes_to!(path)
  set_info_plist_value(
    path: path,
    key: "KPReleaseNotes",
    value: changelog_text
  )
end

def write_release_notes!
  write_release_notes_to!(File.expand_path("../KinoPubAppleClient/Info.plist", __dir__))
end

def archive_and_export!(spec:, build_number:, profile_name:)
  FileUtils.mkdir_p("build")
  archive_path = File.expand_path("build/#{spec[:output]}.xcarchive")
  export_dir = File.expand_path("build/#{spec[:output]}-export")
  FileUtils.rm_rf(archive_path)
  FileUtils.rm_rf(export_dir)
  FileUtils.mkdir_p(export_dir)

  export_plist = write_export_options!(profile_name: profile_name, mac: spec[:mac])

  # Do not pass CODE_SIGN_IDENTITY / PROVISIONING_PROFILE_SPECIFIER as xcargs —
  # those leak onto SPM package targets. Do not pass -allowProvisioningUpdates:
  # Manual + a sigh-installed profile does not need Xcode to talk to Apple, and
  # on Actions that flag asks for an Apple ID that is not there.
  archive_cmd = [
    "xcodebuild", "archive",
    "-project", PROJECT,
    "-scheme", SCHEME,
    "-configuration", "Release",
    "-destination", spec[:destination],
    "-sdk", spec[:sdk],
    "-archivePath", archive_path,
    "-skipMacroValidation",
    "CURRENT_PROJECT_VERSION=#{build_number}",
    "DEVELOPMENT_TEAM=#{TEAM_ID}"
  ]
  sh(Shellwords.join(archive_cmd))

  export_cmd = [
    "xcodebuild", "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_dir,
    "-exportOptionsPlist", export_plist
  ]
  sh(Shellwords.join(export_cmd))

  glob = spec[:mac] ? "*.pkg" : "*.ipa"
  artifact = Dir[File.join(export_dir, glob)].first
  UI.user_error!("exportArchive produced no #{glob} in #{export_dir}") if artifact.nil?

  named = File.expand_path("build/#{spec[:output]}#{File.extname(artifact)}")
  FileUtils.cp(artifact, named)
  named
end

def build_platform!(spec:, build_number:, profile_name:)
  apply_app_signing!(profile_name: profile_name)
  write_release_notes!
  archive_and_export!(spec: spec, build_number: build_number, profile_name: profile_name)
end

def upload_platform!(spec:, artifact:)
  groups = internal_groups
  wait = !groups.empty?

  args = {
    api_key: connect_api_key,
    app_identifier: BUNDLE_ID,
    app_platform: spec[:testflight],
    changelog: changelog_text,
    distribute_external: false,
    notify_external_testers: false,
    skip_waiting_for_build_processing: !wait,
    skip_submission: false
  }

  if spec[:mac]
    args[:pkg] = artifact
  else
    args[:ipa] = artifact
  end

  if wait
    args[:groups] = groups
  end

  upload_with_retry!(args)
end

def upload_with_retry!(args)
  tries = 0
  begin
    upload_to_testflight(args)
  rescue StandardError => e
    message = "#{e.class}: #{e.message}"
    if message.match?(/already been uploaded|Redundant Binary|duplicate binary/i)
      UI.success("App Store Connect already has this binary; continuing")
      return
    end

    tries += 1
    if tries < 3 && message.match?(/status code 500|internal server error/i)
      UI.important("App Store Connect 500 on upload (#{tries}/3). Waiting 30s.")
      sleep 30
      retry
    end
    raise
  end
end

before_all do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
  ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "3"
  ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
end

platform :ios do
  desc "Secrets-free checks: xcproj layout, app-target signing patch, What to Test"
  lane :lint do
    require_xcproj!

    version = marketing_version
    UI.user_error!("Could not read MARKETING_VERSION from project.xcproj") if version.to_s.strip.empty?
    UI.message("MARKETING_VERSION=#{version}")

    notes = changelog_text
    UI.user_error!("What to Test text is empty") if notes.to_s.strip.empty?
    UI.message("What to Test:\n#{notes}")

    original = File.read(XCPROJ)
    Dir.mktmpdir do |dir|
      copy = File.join(dir, "project.xcproj")
      FileUtils.cp(XCPROJ, copy)
      apply_app_signing_to!(copy, profile_name: "KinoPub tvos AppStore")
      patched = File.read(copy)

      UI.user_error!("signing patch missed CODE_SIGN_STYLE Manual") unless patched.include?('"CODE_SIGN_STYLE": "Manual"')
      UI.user_error!("signing patch missed Apple Distribution") unless patched.include?('"CODE_SIGN_IDENTITY": "Apple Distribution"')
      UI.user_error!("signing patch missed macosx Distribution identity") unless patched.include?('"CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Distribution"')
      UI.user_error!("signing patch missed profile specifier") unless patched.include?('"PROVISIONING_PROFILE_SPECIFIER": "KinoPub tvos AppStore"')

      tests = patched[/"name": "KinoPubAppleClientTests".*?"name": "KinoPubAppleClientUITests"/m]
      UI.user_error!("Could not find the unit-test target after the signing patch") if tests.nil?
      UI.user_error!("signing patch leaked Manual onto the test target") if tests.include?('"CODE_SIGN_STYLE": "Manual"')
    end
    UI.user_error!("lint mutated the checkout's project.xcproj") unless File.read(XCPROJ) == original

    export = write_export_options!(profile_name: "KinoPub tvos AppStore", mac: false)
    export_body = File.read(export)
    UI.user_error!("export options missing method app-store-connect") unless export_body.include?("<string>app-store-connect</string>")
    UI.user_error!("export options missing bundle id") unless export_body.include?(BUNDLE_ID)
    UI.user_error!("export options missing team id") unless export_body.include?(TEAM_ID)
    UI.user_error!("non-mac export options leaked installer cert") if export_body.include?("installerSigningCertificate")

    export_mac = write_export_options!(profile_name: "KinoPub macos AppStore", mac: true)
    mac_body = File.read(export_mac)
    UI.user_error!("mac export options missing Apple Distribution") unless mac_body.include?("<string>Apple Distribution</string>")
    UI.user_error!("mac export options missing installer cert") unless mac_body.include?("3rd Party Mac Developer Installer")

    Dir.mktmpdir do |dir|
      plist_copy = File.join(dir, "Info.plist")
      FileUtils.cp(File.expand_path("../KinoPubAppleClient/Info.plist", __dir__), plist_copy)
      write_release_notes_to!(plist_copy)
      UI.user_error!("KPReleaseNotes was not written") unless File.read(plist_copy).include?("KPReleaseNotes")
    end

    UI.success("TestFlight Fastlane lint ok (no App Store Connect secrets)")
  end

  desc "Write the next shared TestFlight build number to BUILD_NUMBERS_FILE"
  lane :reserve_build_number do
    api_key = connect_api_key
    require_appstore_connect_app!(api_key: api_key)
    number = next_build_number(api_key: api_key)
    output = ENV.fetch("BUILD_NUMBERS_FILE", "build_number.env")
    File.open(output, "a") { |f| f.puts "build_number=#{number}" }
    UI.success("Reserved CURRENT_PROJECT_VERSION=#{number}")
  end

  desc "Build and upload one platform (TESTFLIGHT_PLATFORM=ios|tvos|macos) to internal TestFlight"
  lane :beta do
    spec = platform_spec
    api_key = connect_api_key
    require_appstore_connect_app!(api_key: api_key)
    build_number = resolved_build_number

    UI.message("TestFlight #{spec[:name]} build #{build_number} (internal)")
    install_signing!(macos: spec[:mac])
    profile_name = fetch_profile!(sigh_platform: spec[:sigh])
    artifact = build_platform!(spec: spec, build_number: build_number, profile_name: profile_name)
    upload_platform!(spec: spec, artifact: artifact)
  end
end
